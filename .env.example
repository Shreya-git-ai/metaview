# NEXORA — example configuration. Real dev files are GENERATED (with random synthetic secrets) by:
#     python scripts/setup_dev.py
# into config/saas.env, config/col-alpha-01.env, config/col-beta-01.env (git-ignored).

# ---------------- SaaS backend (config/saas.env)
SAAS_HOST=127.0.0.1
SAAS_PORT=8443
SAAS_DB_PATH=data/saas/saas.db
SAAS_TLS_CERT=certificates/server.pem          # required — the backend refuses to start without TLS
SAAS_TLS_KEY=certificates/server.key
SAAS_JWT_SECRET=<random, generated>
SAAS_ENROLLMENT_TOKENS=tenant-alpha:<generated>,tenant-beta:<generated>
SAAS_DEMO_PASSWORD=Demo#2026                    # synthetic demo users only
SAAS_HEARTBEAT_TIMEOUT_S=30
SAAS_STALE_AFTER_S=15
SAAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- Local collector (config/<collector-id>.env)
COLLECTOR_TENANT_ID=tenant-alpha
COLLECTOR_ID=col-alpha-01
COLLECTOR_SAAS_URL=https://localhost:8443       # http:// is refused
COLLECTOR_CA_CERT=certificates/ca.pem           # trust anchor used to verify the SaaS certificate
COLLECTOR_ENROLLMENT_TOKEN=<generated, must match SAAS_ENROLLMENT_TOKENS>
COLLECTOR_DATA_DIR=data/col-alpha-01            # local SQLite (raw store, egress audit, outbox) + credential
COLLECTOR_CONSOLE_PORT=9101                     # local console, bound to 127.0.0.1 only
COLLECTOR_HOSTS=web-01.alpha.internal:web,app-01.alpha.internal:app,db-01.alpha.internal:db
COLLECTOR_SOURCE_SALT=<random — pseudonymisation key, never leaves the collector>
COLLECTOR_SAMPLE_INTERVAL_S=1
COLLECTOR_WINDOW_S=3
COLLECTOR_HEARTBEAT_S=5
# COLLECTOR_INCLUDE_LOCAL_HOST=true             # also send REAL metrics of this machine (psutil)
