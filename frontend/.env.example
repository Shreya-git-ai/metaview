# Frontend configuration (copy to .env.local to override)
# Base path/URL of the SaaS API as seen by the browser (default: /api/v1 through the Vite proxy)
VITE_API_BASE=/api/v1
# Where the separate Tier-1 Local Console app is served
VITE_LOCAL_CONSOLE_URL=http://localhost:5174
# Dev-proxy target for the SaaS API and the CA used to verify it
NEXORA_SAAS_URL=https://localhost:8443
NEXORA_CA_CERT=../certificates/ca.pem
